{
  "class": [
    {"type_name": "番剧", "type_id": "番剧"},
    {"type_name": "国创", "type_id": "国创"},
    {"type_name": "鬼畜", "type_id": "鬼畜"},
    {"type_name": "音乐", "type_id": "音乐"},
    {"type_name": "短剧", "type_id": "微短剧"},
    {"type_name": "沙雕动画", "type_id": "沙雕动画"},
    {"type_name": "海峡两岸", "type_id": "海峡两岸"},
    {"type_name": "電影", "type_id": "電影"},
    {"type_name": "電視劇", "type_id": "電視劇"},
    {"type_name": "韩剧", "type_id": "韩剧"},
    {"type_name": "演唱會", "type_id": "演唱會"},
    {"type_name": "动物世界", "type_id": "动物世界"}
  ],
  "$list": {
    "url": "https://api.bilibili.com/x/web-interface/search/type?search_type=video&keyword={key}&page={pg}",
    "header": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
      "Referer": "https://search.bilibili.com/all"
    },
    "parse": "data.result",
    "field": {
      "vod_id": "aid",
      "vod_name": "title",
      "vod_pic": "pic|http:",
      "vod_remarks": "duration"
    }
  },
  "$detail": {
    "url": "https://api.bilibili.com/x/web-interface/view?aid={id}",
    "header": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
      "Referer": "https://www.bilibili.com"
    },
    "parse": "data",
    "field": {
      "vod_id": "aid",
      "vod_name": "title",
      "vod_pic": "pic|http:",
      "vod_content": "desc",
      "vod_actor": "owner.name",
      "vod_play_from": "B站",
      "vod_play_url": "全集|av{aid}"
    }
  }
}